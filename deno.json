{
  "nodeModulesDir": "auto",
  "exclude": ["dist/", "build/", "docs", "dist-amo/", "dist-archive/","vendor/", "web-ext-artifacts"],
  "imports": {    
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@^0.1.56", // Dev dependency for tests
    "@kuboon/tailwindcss-deno": "jsr:@kuboon/tailwindcss-deno@^0.1.6",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.14",
    "@tailwindcss/oxide": "npm:@tailwindcss/oxide@^4.3.3",
    "katex": "https://esm.sh/katex@0.16.21",
    "preact": "npm:preact@11.0.0-rc.1",
    "tailwindcss": "npm:tailwindcss@^4.3.3"
  },
  "tasks": {
    "clean": "deno run -A build.ts --clean",
    "clean:dev": "deno run -A build.ts --clean",
    "build": "deno run -A build.ts",
    "build:dev": "deno run -A build.ts --dev",
    "package": "deno run -A build.ts --package",
    "test": "deno test -A tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compile": {
    "include": []
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "include": ["src/", "tests/", "build.ts"],
    "exclude": ["dist/", "node_modules/", "vendor/", "dist-amo/", "dist-archive/", "docs/", "tests/gemini/html/"],
    "rules": {
      "tags": ["recommended", "react", "jsx"]
    }
  },
  "fmt": {
    "include": ["src/", "tests/", "build.ts"],
    "exclude": ["dist/", "dist-amo/", "dist-archive/", "tests/gemini/html/"],
    "lineWidth": 120,
    "indentWidth": 4,
    "singleQuote": false,
    "semiColons": true
  }
}
