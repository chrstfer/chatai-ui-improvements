{
  "nodeModulesDir": "auto",
  "exclude": ["dist/", "build/", "docs", "dist-amo/", "dist-archive/","vendor/", "web-ext-artifacts"],
  "imports": {    
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@^0.1.56",
    "@kuboon/tailwindcss-deno": "jsr:@kuboon/tailwindcss-deno@^0.1.6",
    "@logtape/logtape": "jsr:@logtape/logtape@2.3.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.14",
    "@tailwindcss/oxide": "npm:@tailwindcss/oxide@^4.3.3",
    "@testing-library/preact": "npm:@testing-library/preact@^3.2.4",
    "katex": "https://esm.sh/katex@0.16.21",
    "preact": "npm:preact@11.0.0-rc.1",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@internal/contracts/chats": "./src/contracts/chats/index.ts",
    "@internal/contracts/core": "./src/contracts/core/index.ts",
    "@internal/contracts/features/matchers": "./src/contracts/features/matchers/index.ts",
    "@internal/contracts/features/parsers": "./src/contracts/features/parsers/index.ts",
    "@internal/contracts/features/renderers": "./src/contracts/features/renderers/index.ts",
    "@internal/contracts/features/serializers": "./src/contracts/features/serializers/index.ts",
    "@internal/core/logging": "./src/core/logging/index.ts",
    "@internal/core/rpc": "./src/core/rpc/index.ts",
    "@internal/core/storage": "./src/core/storage/index.ts",
    "@internal/core/utils": "./src/core/utils/index.ts",
    "@internal/features/chats/duckai": "./src/features/chats/duckai/index.ts",
    "@internal/features/chats/gemini": "./src/features/chats/gemini/index.ts",
    "@internal/features/matchers": "./src/features/matchers/index.ts",
    "@internal/features/parsers/json": "./src/features/parsers/json/index.ts",
    "@internal/features/parsers/markdown": "./src/features/parsers/markdown/index.ts",
    "@internal/features/parsers/math": "./src/features/parsers/math/index.ts",
    "@internal/features/parsers/org": "./src/features/parsers/org/index.ts",
    "@internal/features/renderers/org": "./src/features/renderers/org/index.ts",
    "@internal/registries": "./src/registries/index.ts",
    "@internal/store": "./src/store/index.ts",
    "@internal/styles": "./src/styles/index.ts",
    "@internal/views/codeblock": "./src/views/codeblock/index.ts",
    "@internal/views/common": "./src/views/common/index.ts",
    "@internal/views/settings": "./src/views/settings/index.ts",
    "@internal/tests/fixtures": "./tests/fixtures/index.ts"
  },
  "tasks": {
    "clean": "deno run -A build.ts --clean",
    "clean:dev": "deno run -A build.ts --clean --dev",
    "build": "deno run -A build.ts",
    "build:dev": "deno run -A build.ts --dev",
    "package": "deno run -A build.ts --package",
    "test": "deno test -A tests/",
    "test:unit": "deno test -A --filter \"unit:\" tests/",
    "test:integration": "deno test -A --filter \"integration:\" tests/",
    "test:e2e": "deno test -A --filter \"e2e:\" tests/",
    "test:bench": "deno test -A --filter \"bench:\" tests/",
    "bench:tests:all": "deno bench -A tests/",
    "bench:tests:unit": "deno bench -A --filter \"unit:\" tests/",
    "bench:tests:integration": "deno bench -A --filter \"integration:\" tests/",
    "bench:tests:e2e": "deno bench -A --filter \"e2e:\" tests/",
    "bench:tests:bench": "deno bench -A --filter \"bench:\" tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "audit:tests": "deno run -A scripts/audit_test_pipeline.ts",
    "audit:tests:query": "deno run -A scripts/query_test_audit.ts"
  },
  "compile": {
    "include": []
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "include": ["src/", "tests/", "build.ts"],
    "exclude": ["dist/", "node_modules/", "vendor/", "dist-amo/", "dist-archive/", "docs/", "tests/fixtures/html/"],
    "rules": {
      "tags": ["recommended", "react", "jsx"]
    }
  },
  "fmt": {
    "include": ["src/", "tests/", "build.ts"],
    "exclude": ["dist/", "dist-amo/", "dist-archive/", "tests/fixtures/html/"],
    "lineWidth": 120,
    "indentWidth": 4,
    "singleQuote": false,
    "semiColons": true
  }
}
