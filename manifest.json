{
  "manifest_version": 3,
  "name": "AI Chat Rendering improvements with org-mode",
  "version": "0.1.2",
  "description": "High-density full-width layout and custom org-mode rendering for AI Chat. Currently supports Gemini.",
  "homepage_url": "https://www.github.com/chrstfer/gemini-org-ui",
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-org-ui@dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "vendor/katex.min.css",
        "styles/general.css"
      ],
      "js": [
        "vendor/katex.min.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
