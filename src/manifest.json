{
    "manifest_version": 3,
    "name": "AI Chat UI Improvements",
    "version": "0.2.0",
    "description": "UI Improvements for AI Chats. Currently supports Gemini and DuckDuckGo AI.",
    "homepage_url": "https://www.github.com/chrstfer/gemini-org-ui",
    "browser_specific_settings": {
        "gecko": {
            "id": "chatai-ui-improvements@dev",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "action": {
        "default_title": "AI Chat UI Improvements",
        "default_icon": "assets/icon.svg"
    },
    "icons": {
        "48": "assets/icon.svg",
        "96": "assets/icon.svg",
        "128": "assets/icon.svg"
    },
    "background": {
        "scripts": ["src/entrypoints/background.ts"],
        "type": "module"
    },
    "permissions": [
        "storage",
        "activeTab",
        "tabs"
    ],
    "host_permissions": [
        "https://gemini.google.com/*",
        "https://duck.ai/*",
        "https://duckduckgo.com/chat*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*",
                "https://duck.ai/*",
                "https://duckduckgo.com/chat*"
            ],
            "css": [
                "vendor/katex.min.css",
                "src/styles/globals.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": ["src/entrypoints/content.ts"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://duck.ai/*",
                "https://duckduckgo.com/chat*"
            ],
            "js": ["src/entrypoints/content.ts"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "app.js"
            ],
            "matches": [
                "https://gemini.google.com/*",
                "https://duck.ai/*",
                "https://duckduckgo.com/chat*"
            ]
        }
    ]
}
